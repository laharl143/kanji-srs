{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "e2e": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_E2E": "1"
      }
    }
  }
}
