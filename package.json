{
  "name": "kanji-srs",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "doctor": "expo-doctor",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "pipeline:download": "tsx pipeline/src/download.ts",
    "pipeline:build": "tsx pipeline/src/build.ts",
    "pipeline:bundle": "tsx pipeline/src/bundle.ts",
    "pipeline:validate": "tsx pipeline/src/validate.ts",
    "pipeline:batch": "tsx pipeline/src/batch.ts",
    "pipeline:merge": "tsx pipeline/src/merge.ts"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-jp": "^0.4.4",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "undici": "^8.12.3",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
